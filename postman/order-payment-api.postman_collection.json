{
  "info": {
    "name": "Order and Payment API",
    "description": "Authentication, orders, and payments. Set base_url, then run Register or Login. The token and order id are saved for the later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "order_id",
      "value": "1"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "    pm.collectionVariables.set('token', body.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"ada@example.com\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/register",
            "description": "Creates a user and returns a bearer token."
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"ada@example.com\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\"\n}"
                },
                "url": "{{base_url}}/api/register"
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"token\": \"1|plain-text-token\",\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Ada Lovelace\",\n    \"email\": \"ada@example.com\"\n  }\n}"
            },
            {
              "name": "422 Validation error",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"ada@example.com\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\"\n}"
                },
                "url": "{{base_url}}/api/register"
              },
              "status": "Unprocessable Content",
              "code": 422,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"The email has already been taken.\",\n  \"errors\": {\n    \"email\": [\n      \"The email has already been taken.\"\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "    pm.collectionVariables.set('token', body.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/login",
            "description": "Returns a bearer token for an existing user."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"password\"\n}"
                },
                "url": "{{base_url}}/api/login"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"token\": \"2|plain-text-token\",\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Ada Lovelace\",\n    \"email\": \"ada@example.com\"\n  }\n}"
            },
            {
              "name": "401 Invalid credentials",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"wrong-password\"\n}"
                },
                "url": "{{base_url}}/api/login"
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"These credentials do not match our records.\"\n}"
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/user",
            "description": "Returns the user for the bearer token."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": "{{base_url}}/api/user"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"data\": {\n    \"id\": 1,\n    \"name\": \"Ada Lovelace\",\n    \"email\": \"ada@example.com\"\n  }\n}"
            },
            {
              "name": "401 Missing token",
              "originalRequest": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": "{{base_url}}/api/user"
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Unauthenticated.\"\n}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/logout",
            "description": "Deletes the bearer token used for this request."
          },
          "response": [
            {
              "name": "204 No Content",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": "{{base_url}}/api/logout"
              },
              "status": "No Content",
              "code": 204,
              "header": [],
              "body": ""
            },
            {
              "name": "401 Missing token",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": "{{base_url}}/api/logout"
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Unauthenticated.\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) {",
                  "    pm.collectionVariables.set('order_id', String(body.data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_name\": \"Widget\",\n      \"quantity\": 2,\n      \"unit_price\": \"10.50\"\n    },\n    {\n      \"product_name\": \"Cable\",\n      \"quantity\": 1,\n      \"unit_price\": \"5.00\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/orders",
            "description": "Creates a pending order for the logged-in user. The total is the sum of quantity times unit price."
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"items\": [\n    {\n      \"product_name\": \"Widget\",\n      \"quantity\": 2,\n      \"unit_price\": \"10.50\"\n    },\n    {\n      \"product_name\": \"Cable\",\n      \"quantity\": 1,\n      \"unit_price\": \"5.00\"\n    }\n  ]\n}"
                },
                "url": "{{base_url}}/api/orders"
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"data\": {\n    \"id\": 1,\n    \"status\": \"pending\",\n    \"total\": \"26.00\",\n    \"items\": [\n      {\n        \"id\": 1,\n        \"product_name\": \"Widget\",\n        \"quantity\": 2,\n        \"unit_price\": \"10.50\",\n        \"line_total\": \"21.00\"\n      },\n      {\n        \"id\": 2,\n        \"product_name\": \"Cable\",\n        \"quantity\": 1,\n        \"unit_price\": \"5.00\",\n        \"line_total\": \"5.00\"\n      }\n    ]\n  }\n}"
            },
            {
              "name": "422 Validation error",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": { "mode": "raw", "raw": "{}" },
                "url": "{{base_url}}/api/orders"
              },
              "status": "Unprocessable Content",
              "code": 422,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"The items field is required.\",\n  \"errors\": {\n    \"items\": [\n      \"The items field is required.\"\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "List orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/orders?status=pending&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["api", "orders"],
              "query": [
                { "key": "status", "value": "pending", "description": "pending, confirmed, or cancelled. Omit to return every status." },
                { "key": "per_page", "value": "15" }
              ]
            },
            "description": "Returns the logged-in user's orders. Filter with status and paginate with per_page."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": "{{base_url}}/api/orders?status=pending&per_page=15"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"data\": [\n    {\n      \"id\": 1,\n      \"status\": \"pending\",\n      \"total\": \"26.00\",\n      \"items\": []\n    }\n  ],\n  \"links\": {\n    \"first\": \"http://localhost:8000/api/orders?page=1\",\n    \"last\": \"http://localhost:8000/api/orders?page=1\",\n    \"prev\": null,\n    \"next\": null\n  },\n  \"meta\": {\n    \"current_page\": 1,\n    \"per_page\": 15,\n    \"total\": 1\n  }\n}"
            },
            {
              "name": "422 Unknown status",
              "originalRequest": {
                "method": "GET",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": "{{base_url}}/api/orders?status=shipped"
              },
              "status": "Unprocessable Content",
              "code": 422,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"The selected status is invalid.\",\n  \"errors\": {\n    \"status\": [\n      \"The selected status is invalid.\"\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "Show order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/orders/{{order_id}}"
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": "{{base_url}}/api/orders/{{order_id}}"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"data\": {\n    \"id\": 1,\n    \"status\": \"pending\",\n    \"total\": \"26.00\",\n    \"items\": [\n      {\n        \"id\": 1,\n        \"product_name\": \"Widget\",\n        \"quantity\": 2,\n        \"unit_price\": \"10.50\",\n        \"line_total\": \"21.00\"\n      }\n    ]\n  }\n}"
            },
            {
              "name": "404 Another user's order",
              "originalRequest": {
                "method": "GET",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": "{{base_url}}/api/orders/999"
              },
              "status": "Not Found",
              "code": 404,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Not Found\"\n}"
            }
          ]
        },
        {
          "name": "Update order",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\",\n  \"items\": [\n    {\n      \"product_name\": \"Cable\",\n      \"quantity\": 3,\n      \"unit_price\": \"4.25\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/orders/{{order_id}}",
            "description": "Confirms the order and replaces its items. Send status, items, or both. The total is recalculated when items change."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "PUT",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"confirmed\"\n}"
                },
                "url": "{{base_url}}/api/orders/{{order_id}}"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"data\": {\n    \"id\": 1,\n    \"status\": \"confirmed\",\n    \"total\": \"12.75\",\n    \"items\": [\n      {\n        \"id\": 3,\n        \"product_name\": \"Cable\",\n        \"quantity\": 3,\n        \"unit_price\": \"4.25\",\n        \"line_total\": \"12.75\"\n      }\n    ]\n  }\n}"
            },
            {
              "name": "422 Invalid status",
              "originalRequest": {
                "method": "PUT",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"shipped\"\n}"
                },
                "url": "{{base_url}}/api/orders/{{order_id}}"
              },
              "status": "Unprocessable Content",
              "code": 422,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"The selected status is invalid.\",\n  \"errors\": {\n    \"status\": [\n      \"The selected status is invalid.\"\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "Delete order",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/orders/{{order_id}}",
            "description": "Deletes the order and its items when the order has no payments."
          },
          "response": [
            {
              "name": "204 No Content",
              "originalRequest": {
                "method": "DELETE",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": "{{base_url}}/api/orders/{{order_id}}"
              },
              "status": "No Content",
              "code": 204,
              "header": [],
              "body": ""
            },
            {
              "name": "409 Order has a payment",
              "originalRequest": {
                "method": "DELETE",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": "{{base_url}}/api/orders/{{order_id}}"
              },
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"An order with payments cannot be deleted.\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Process payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"credit_card\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/orders/{{order_id}}/payments",
            "description": "Charges a confirmed order through the gateway for method. Use credit_card or paypal. Set decline to true to store a failed payment. The order must be confirmed first."
          },
          "response": [
            {
              "name": "201 Successful",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"method\": \"credit_card\"\n}"
                },
                "url": "{{base_url}}/api/orders/{{order_id}}/payments"
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"data\": {\n    \"id\": 1,\n    \"order_id\": 1,\n    \"method\": \"credit_card\",\n    \"status\": \"successful\",\n    \"amount\": \"26.00\",\n    \"gateway_reference\": \"cc_5f3b1c0e-7a2d-4e8b-9c1a-2d4e6f8a0b1c\"\n  }\n}"
            },
            {
              "name": "201 Declined",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"method\": \"paypal\",\n  \"decline\": true\n}"
                },
                "url": "{{base_url}}/api/orders/{{order_id}}/payments"
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"data\": {\n    \"id\": 2,\n    \"order_id\": 1,\n    \"method\": \"paypal\",\n    \"status\": \"failed\",\n    \"amount\": \"26.00\",\n    \"gateway_reference\": null\n  }\n}"
            },
            {
              "name": "409 Order is not confirmed",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"method\": \"credit_card\"\n}"
                },
                "url": "{{base_url}}/api/orders/{{order_id}}/payments"
              },
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Payments can only be processed for confirmed orders.\"\n}"
            },
            {
              "name": "422 Unknown method",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"method\": \"cash\"\n}"
                },
                "url": "{{base_url}}/api/orders/{{order_id}}/payments"
              },
              "status": "Unprocessable Content",
